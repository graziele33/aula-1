programa {
  funcao inicio() {

  //Declaraçao de Variaveis  
   real celsius, fahrenheit

   //Entrada de Dados
   escreva("Programa de Temperatura\n\n")

   escreva("Informe a temperatura em graus Celsius:")
   leia("celsius")

   //Formula da temperatura
   fahrenheit = (celsius * 1.8) + 32

  //Exibição de Dados
  escreva(" A temperatura em Fahrenheit è : * + fahrenheit")
  }
}
