programa {
  funcao inicio() {
    
    //Declaraçao de Variaveis
    real precoPoduto, valorTotal
    inteiro quantidade 

    //Entrada de Dados
    escreva("Programa para calcular a quantidade de produto\n")

    escreva("Informe o valor do produto:")
    leia("precoProduto")
    escreva("Informe a quantidade......:")
    leia(quantidade)

    //Calculo do preço do produto pela quantidade
    valorTotal =precoPoduto * quantidade

    //Saida de Dados
    escreva("O valor totaldas compras è: * + valorTotal")
  }
}
